{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@ %d 件": {
      "comment": "Containers",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %d"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %d개"
          }
        }
      }
    },
    "%@ 永久解锁": {
      "comment": "Lifetime unlock and free quota",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Unlock Forever"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で買い切り版を購入"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 평생 이용"
          }
        }
      }
    },
    "%@，里面积累了 %d 件内容。%@": {
      "comment": "Containers",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contains %d items. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には%d件入っています。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 %d개의 내용이 있어요. %@"
          }
        }
      }
    },
